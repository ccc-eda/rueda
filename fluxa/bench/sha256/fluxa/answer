    // The 80-byte header occupies 64 bytes in the first block and 16 bytes
    // in the second.  SHA-256 padding then adds 0x80 at byte 80 and stores
    // the 640-bit message length in the last word of the second block.
    let mut block0: [u32; 16] = [0; 16];
    for i in 0..16 {
        block0[i] = header[i];
    }
    let mut block1: [u32; 16] = [0; 16];
    block1[0] = header[16];
    block1[1] = header[17];
    block1[2] = header[18];
    block1[3] = header[19];
    block1[4] = 0x80000000;
    block1[15] = 0x00000280;

    let mut digest: [u32; 8] = compress(block0);
    digest = compress(block1);

    // The second SHA-256 hashes the first 32-byte digest.
    let mut second: [u32; 16] = [0; 16];
    for i in 0..8 {
        second[i] = digest[i];
    }
    second[8] = 0x80000000;
    second[15] = 0x00000100;
    compress(second)
}</new>
