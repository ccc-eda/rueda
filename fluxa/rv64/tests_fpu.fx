// 由 rv64/fpgen.py 產生，請勿手改（python3 rv64/fpgen.py > rv64/tests_fpu.fx）
// 每個向量：(指令字, rs1 值, rs2 值, rs3 值, 期望結果, 期望 fflags)；直接驅動 fp_op / fma_op

fn fp_check(inst: _, a: _, b: _, c: _, want: _, fl: _) -> u32 {
    let mut bad: u32 = 0;
    for k in 0..len(inst) {
        let r = if inst[k][6:0] == 0x53 { fp_op(inst[k], a[k], b[k]) } else { fma_op(inst[k], a[k], b[k], c[k]) };
        if r.0 != want[k] || r.1 != fl[k] { bad += 1; }
    }
    bad
}

