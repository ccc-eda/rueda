// 74HC595 跑馬燈擴充板（examples/runner.board，插在 PMOD1A）：一顆亮著的 LED 在 8 顆之間來回跑。
// FPGA 只用三支腳就能控制 8 顆 LED：
//   腳 3 = SER（資料）、腳 4 = SRCLK（移位時脈）、腳 7 = RCLK（鎖存時脈）。
// 送一次：8 個位元依序放上 SER（高位先），每個打一下 SRCLK 移進去；最後打一下 RCLK，8 顆 LED 同時換成新的值。
// 每個位元分成四拍（q）：放資料、SRCLK 升、SRCLK 降、空一拍。
module Runner #(
    param STEP  : u32 = 1_200_000, // 每 0.1 秒移一格（12 MHz）
    param STEP_W: u32 = 21       ,
) (
    i_clk  : input  clock,
    i_rst  : input  reset,
    o_ser  : output logic,
    o_srclk: output logic,
    o_rclk : output logic,
) {
    // 上電時正反器都是 0（沒按重置也一樣），所以全 0 就是合理的開頭：第 0 顆、往上、馬上送
    var idx : logic<3>     ; // 亮的是第幾顆
    var dir : logic        ; // 0 = 往高位、1 = 往低位
    var idle: logic        ; // 0 = 正在送到 74HC595，1 = 等下一步
    var slot: logic<4>     ; // 第幾個位元（0-7），8 = 鎖存
    var q   : logic<2>     ;
    var wait: logic<STEP_W>;

    let pat: logic<8> = 8'b1 << idx;

    always_ff {
        if_reset {
            idx     = 0;
            dir     = 0;
            idle    = 0;
            slot    = 0;
            q       = 0;
            wait    = 0;
            o_ser   = 0;
            o_srclk = 0;
            o_rclk  = 0;
        } else if idle {
            if wait == STEP - 1 {
                wait = 0;
                idle = 0;
                // 移一格，到頭就回頭
                if dir == 0 {
                    if idx == 7 {
                        dir = 1;
                        idx = 6;
                    } else {
                        idx = idx + 1;
                    }
                } else {
                    if idx == 0 {
                        dir = 0;
                        idx = 1;
                    } else {
                        idx = idx - 1;
                    }
                }
            } else {
                wait = wait + 1;
            }
        } else {
            if slot <= 7 {
                if q == 0 {
                    o_ser = pat[7 - slot];
                } else if q == 1 {
                    o_srclk = 1;
                } else if q == 2 {
                    o_srclk = 0;
                }
            } else if q == 1 {
                o_rclk = 1;
            } else if q == 2 {
                o_rclk = 0;
            }
            if q == 3 {
                if slot == 8 {
                    idle = 1;
                    slot = 0;
                } else {
                    slot = slot + 1;
                }
            }
            q = q + 1;
        }
    }
}

// 測試：STEP = 2。testbench 裡有一個 74HC595（SRCLK 上升緣移入、RCLK 上升緣鎖存），
// 第一次送完應該顯示 0x01，下一次 0x02。
#[test(test_runner)]
module TestRunner {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);

    var ser  : logic;
    var srclk: logic;
    var rclk : logic;

    var prev_srclk: logic   ;
    var prev_rclk : logic   ;
    var sr        : logic<8>;
    var shown     : logic<8>;
    always_ff (clk, rst) {
        if_reset {
            prev_srclk = 0;
            prev_rclk  = 0;
            sr         = 0;
            shown      = 0;
        } else {
            prev_srclk = srclk;
            prev_rclk  = rclk;
            if srclk && !prev_srclk {
                sr = {sr[6:0], ser};
            }
            if rclk && !prev_rclk {
                shown = sr;
            }
        }
    }

    inst dut: Runner #(
        STEP  : 2,
        STEP_W: 2,
    ) (
        i_clk  : clk  ,
        i_rst  : rst  ,
        o_ser  : ser  ,
        o_srclk: srclk,
        o_rclk : rclk ,
    );

    initial {
        rst.assert();
        // 一次送出：9 個時段，每個 4 拍
        clk.next(40);
        $assert(shown == 8'h01, "first D0");
        clk.next(40);
        $assert(shown == 8'h02, "then D1");
        $finish();
    }
}
